<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />

    <style>
      @import
      url('https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap');
      :root { --text-body: #000000; --label-color: #3c406e; --subtitle: #545454;
      --background-secondary: #e2e5ec; --background-line: #d8d7d5; --green: #74cf93; --white:
      #ffffff; --color-primary: #932839; --color-secondary: #922a3b; --color-tertiary: #942637; } *
      { box-sizing: inherit; font-size: 1.2rem; line-height: 1.6rem; font-weight: 400; } html {
      box-sizing: border-box; font-size: 62.5%; } body { /* font-family: 'EB Garamond', serif; */
      font-family: 'Montserrat', sans-serif; font-optical-sizing: auto; -webkit-text-size-adjust:
      100%; margin: 0; padding: 0; color: var(--text-body); background-color: var(--white); width:
      795px; scrollbar-width: none; margin-bottom: 100%; } body::-webkit-scrollbar { display: none;
      } p { margin: 0; } a { font-style: italic; color: var(--text-body); }
    </style>
    <title>Document</title>
  </head>

  <body>
    <div style='padding: 50px 40px; position: relative'>
      <!-- block header -->
      <div
        style='position: absolute; top: 0; left: 40px; width: 277px; height: 50px; background: var(--color-tertiary)'
      >
    
    </div>

      <!-- MAIN CONTENT -->
      <div style='display: flex; align-items: start; justify-content: space-between; gap: 20px'>
        <!-- LEFT CONTENT -->
        <div style='flex: 2'>
          <!-- name -->
          <h1
            style='
              font-size: 36px;
              width: 100%;
              color: var(--color-tertiary);
              margin-top: 50px;
              font-weight: 700;
              text-transform: uppercase;
              line-height: 36px;
              margin-bottom: 0;
            '
          >
            {{name}}
          </h1>
          <h1
            style='
              font-size: 36px;
              width: 100%;
              color: var(--color-secondary);
              margin-top: 50px;
              font-weight: 700;
              text-transform: uppercase;
              line-height: 36px;
              margin-bottom: 0;
            '
          >
            {{jobTitle}}
          </h1>
          <!-- contact info -->
          <div
            style='display: flex; flex-wrap: wrap; column-gap: 20px; row-gap: 30px; margin-top: 50px'
          >
            <!-- info item ( phone number ) -->
            <div style='display: flex; align-items: center; gap: 10px; min-width: calc(50% - 10px)'>
              <img
                crossorigin='anonymous'
                src='https://media-public.canva.com/KrKpY/MAE4-NKrKpY/1/t.png'
                draggable='false'
                alt='phone icon'
                style='object-fit: fill; width: 14.9px; height: 14.9px'
              />
              <p>{{phoneNumber}}</p>
            </div>

            <!-- info item ( address ) -->
            <div style='display: flex; align-items: center; gap: 10px; min-width: calc(50% - 10px)'>
              <img
                crossorigin='anonymous'
                src='https://media-public.canva.com/f2nc4/MAFTTXf2nc4/1/t.png'
                draggable='false'
                alt='phone icon'
                style='object-fit: fill; width: 14.9px; height: 14.9px'
              />
              <p>{{address}}</p>
            </div>

            <!-- info item ( email ) -->
            <div style='display: flex; align-items: center; gap: 10px; min-width: calc(50% - 10px)'>
              <img
                crossorigin='anonymous'
                src='https://media-public.canva.com/L_MR0/MAE4-PL_MR0/1/t.png'
                draggable='false'
                alt='phone icon'
                style='object-fit: fill; width: 14.9px; height: 14.9px'
              />
              <p>{{email}}</p>
            </div>

            <!-- info item ( social ) -->
            <div style='display: flex; align-items: center; gap: 10px; min-width: calc(50% - 10px)'>
              <img
                crossorigin='anonymous'
                src='https://media-public.canva.com/0WmAs/MAFTYz0WmAs/1/t.png'
                draggable='false'
                alt='phone icon'
                style='object-fit: fill; width: 14.9px; height: 14.9px'
              />
              <a
                href='www.finder.vung.dev'
                target='_blank'
                style='text-decoration: unset; font-style: normal'
              >www.finder.vung.dev</a>
            </div>
          </div>

          <!-- line -->
          <div
            style='width: 100%; height: 1px; background: var(--background-line); margin: 35px 0 35px 0'
          ></div>

          <!-- EXPERIENCES -->
          <div>
            <h2
              style='
                font-size: 20px;
                line-height: 22px;
                width: 100%;
                color: var(--color-secondary);
                margin: 0;
                font-weight: 700;
                text-transform: uppercase;
              '
            >
              Experience
            </h2>

            <!-- list experiences -->
            <div
              style='display: flex; align-items: start; justify-content: start; flex-direction: column; margin-top: 30px; gap: 30px'
            >
              <!-- item experiences -->
              {{#each workExperiences}}
                <!-- item experiences -->
                <div>
                  <p
                    style='color: var(--label-color); text-transform: uppercase word-wrap: break-word; font-weight: 700; width: 100%'
                  >
                    {{jobTitleId}}
            
                  </p>
                  <span
                    style='color: var(--subtitle); font-style: italic; margin-top: 4px; width: 100%; word-wrap: break-word; display: block'
                  >{{companyName}}</span>

                  <!-- description -->
                  <ul style='margin-bottom: 0; margin-top: 10px; padding-left: 12px'>
                    <li style='margin-bottom: 4px max-width 350'>
                      {{description}}
                    </li>
                  </ul>
                </div>
              {{/each}}
            </div>
          </div>
            <!-- line -->
            <div
            style='width: 100%; height: 1px; background: var(--background-line); margin: 40px 0 30px 0'
          ></div>
             <!-- list prroject -->
               <h2
              style='
                font-size: 20px;
                line-height: 22px;
                width: 100%;
                color: var(--color-secondary);
                margin: 0;
                font-weight: 700;
                text-transform: uppercase;
              '
            >
              Projects
            </h2>

   <div
              style='display: flex; align-items: start; justify-content: start; flex-direction: column; margin-top: 30px; gap: 30px'
            >
              <!-- item experiences -->
              {{#each projects}}
                <!-- item experiences -->
                <div>
                  <p
                    style='color: var(--label-color); text-transform: uppercase; width: 50%; word-wrap: break-word; font-weight: 700'
                  >
                    {{title}}
                    -
                    {{role}}
                  </p>
                  <!-- description -->
                  <ul style='margin-bottom: 0; margin-top: 10px; padding-left: 12px'>
                    <li style='margin-bottom: 4px max-width 350'>
                      {{description}}
                    </li>
                  </ul>
                </div>
              {{/each}}
            </div>
          <!-- line -->
          <div
            style='width: 100%; height: 1px; background: var(--background-line); margin: 40px 0 30px 0'
          ></div>

          <!-- SKILLS -->
          <div>
            <h2
              style='
                font-size: 20px;
                line-height: 22px;
                width: 100%;
                color: var(--color-secondary);
                margin: 0;
                font-weight: 700;
                text-transform: uppercase;
              '
            >
              Skills
            </h2>

            <!-- skill list -->
            <div
              style='
                display: flex;
                align-items: start;
                justify-content: space-between;
                column-gap: 40px;
                row-gap: 30px;
                flex-wrap: wrap;
                margin-top: 30px;
              '
            >
              <!-- skill items -->
              {{#each skillContents}}
                <!-- item skill -->
                <div>
                  <p
                    style='color: var(--label-color); text-transform: uppercase; width: 100%; word-wrap: break-word; font-weight: 700'
                  >
                    {{this}}
                  </p>
                </div>
              {{/each}}
            </div>
          </div>
        </div>

        <!-- RIGHT CONTENT -->
        <div style='flex: 1'>
          <!-- avatar -->
          <div style='width: 100%'>
            <img
              crossorigin='anonymous'
              src='https://res.cloudinary.com/dgxciqlts/image/upload/v1709873666/assets/avatar-3_qeigdn.png'
              draggable='false'
              style='object-fit: fill; width: 100%; aspect-ratio: 1 / 1'
            />
          </div>

          <!-- PROFILE -->
          <div style='width: 100%; margin-top: 30px'>
            <div
              style='
                background: var(--color-tertiary);
                color: var(--white);
                text-transform: uppercase;
                font-size: 1.5rem;
                font-weight: bold;
                line-height: 15px;
                padding: 15px 20px;
              '
            >
              profile summary
            </div>
          <div>
            <p
              style='
                padding: 20px 15px;
                background: var(--background-secondary);
                margin-top: 8px;
                color: var(--subtitle);
                font-style: italic;
              '
            >
              {{profileSummary}}
            </p>
          </div>

          <!-- EDUCATION -->
          <div style='width: 100%; margin-top: 30px'>
            <div
              style='
                background: var(--color-tertiary);
                color: var(--white);
                text-transform: uppercase;
                font-size: 1.5rem;
                font-weight: bold;
                line-height: 15px;
                padding: 15px 20px;
              '
            >
              Education
            </div>

            <!-- education list -->
            <div
              style='
                padding: 20px 15px;
                background: var(--background-secondary);
                margin-top: 8px;
                display: flex;
                flex-direction: column;
                gap: 20px;
              '
              class='educations'
            >

              <!-- education item -->
              <div class='edutcation-item'>
                {{#each educations}}
                  <!-- item education -->
                  <div>
                    <p
                      style='color: var(--label-color); text-transform: uppercase; width: 100%; word-wrap: break-word; font-weight: 700'
                    >
                      {{degree}}
                      |
                      {{graduationAt}}
                    </p>
                    <span
                      style='color: var(--subtitle); font-style: italic; margin-top: 4px; width: 100%; word-wrap: break-word; display: block'
                    >{{major}}</span>

                    <!-- description -->
                    <ul style='margin-bottom: 0; margin-top: 10px; padding-left: 12px'>
                      <li style='margin-bottom: 4px'>
                        GPA:
                        {{gpa}}
                      </li>
                      <li style='margin-bottom: 4px'>
                        Awards:
                        {{#each awards}}<span>{{this}}</span>{{/each}}
                      </li>
                      <li style='margin-bottom: 4px'>
                        Relevant Course Works:
                        {{#each relevantCourseWorks}}<span>{{this}}</span>{{/each}}
                      </li>
                    </ul>
                  </div>
                {{/each}}
              </div>
            </div>
          </div>

          <!-- CERTIFICATE -->
          <div style='width: 100%; margin-top: 30px'>
            <div
              style='
                background: var(--color-tertiary);
                color: var(--white);
                text-transform: uppercase;
                font-size: 1.5rem;
                font-weight: bold;
                line-height: 15px;
                padding: 15px 20px;
              '
            >
              Certifications
            </div>

            <!-- certificate list -->
            <div
              style='
                padding: 20px 15px;
                background: var(--background-secondary);
                margin-top: 8px;
                display: flex;
                flex-direction: column;
                gap: 20px;
              '
              class='educations'
            >
              <!-- certification item -->
              <div class='edutcation-item'>
                <p
                  style='color: var(--label-color); text-transform: uppercase; font-weight: bold'
                >Certified Paralegal (CP)</p>
                <span
                  style='text-transform: capitalize; color: var(--subtitle); font-style: italic'
                >National Association of Legal Assistants (NALA)</span>
              </div>

              <!-- certification item -->
              <!-- <div class="edutcation-item">
              <p style="
                 color: var(--label-color);
                 text-transform: uppercase;
                 font-weight: bold;
               ">
                Notary Public
              </p>
              <span style="
                 text-transform: capitalize;
                 color: var(--subtitle);
                 font-style: italic;
               ">State of ST</span>
            </div> -->
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>